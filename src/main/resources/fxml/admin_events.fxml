<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oktayosman.ticketcenter.controller.AdminEventsController"
            stylesheets="@../styles.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-border-color: #e5e5e5; -fx-border-width: 0 0 1 0;">
            <Label text="All Events" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="totalEventsLabel" text="Total: 0" style="-fx-text-fill: #6b7280;"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
            <Button text="← Back to Dashboard" onAction="#handleBack" style="-fx-background-color: #6b7280; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <TextField fx:id="searchField" promptText="Search by name, location, organizer, category or status…"/>

            <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn"       text="Event Name"  prefWidth="200"/>
                    <TableColumn fx:id="categoryColumn"   text="Category"    prefWidth="120"/>
                    <TableColumn fx:id="organizerColumn"  text="Organizer"   prefWidth="160"/>
                    <TableColumn fx:id="dateColumn"       text="Date"        prefWidth="140"/>
                    <TableColumn fx:id="statusColumn"     text="Status"      prefWidth="100"/>
                    <TableColumn fx:id="locationColumn"   text="Location"    prefWidth="160"/>
                    <TableColumn fx:id="capacityColumn"   text="Capacity"    prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>

