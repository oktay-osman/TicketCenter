<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oktayosman.ticketcenter.controller.OrganizerDashboardController"
            stylesheets="@../styles.css">

    <!-- TOP BAR (title + logout) -->
    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-alignment: CENTER_LEFT;">
            <Label text="Organizer Dashboard" style="-fx-text-fill: #2c3e50; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="logoutButton" text="Logout" />
        </HBox>
    </top>

    <!-- CENTER TABS -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <!-- CREATE EVENT TAB -->
            <Tab text="Create Event">
                <ScrollPane fitToWidth="true">
                    <GridPane hgap="10" vgap="10" style="-fx-padding: 30;">

                        <Label text="Create Event" GridPane.rowIndex="0" GridPane.columnSpan="2"
                               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

                        <!-- Name -->
                        <Label text="Name:" GridPane.rowIndex="1"/>
                        <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <!-- Category -->
                        <Label text="Category:" GridPane.rowIndex="2"/>
                        <ComboBox fx:id="categoryCombo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <!-- Ticket limit per person -->
                        <Label text="Ticket limit:" GridPane.rowIndex="3"/>
                        <TextField fx:id="ticketLimitField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <!-- Event date -->
                        <Label text="Event date:" GridPane.rowIndex="4"/>
                        <DatePicker fx:id="eventDatePicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <!-- Location -->
                        <Label text="Location:" GridPane.rowIndex="5"/>
                        <TextField fx:id="locationField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                        <!-- Description -->
                        <Label text="Description:" GridPane.rowIndex="6"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4"
                                  GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                        <!-- Status -->
                        <Label text="Status:" GridPane.rowIndex="7"/>
                        <ComboBox fx:id="statusCombo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                        <!-- Capacity -->
                        <Label text="Capacity:" GridPane.rowIndex="8"/>
                        <TextField fx:id="capacityField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                        <!-- Image -->
                        <Label text="Image:" GridPane.rowIndex="9"/>
                        <HBox spacing="10" GridPane.rowIndex="9" GridPane.columnIndex="1">
                            <Button text="Choose File" fx:id="imageButton"/>
                            <Label fx:id="imageLabel" text="No file selected"/>
                        </HBox>

                        <!-- Ticket Pricing -->
                        <Label text="Ticket Types:" GridPane.rowIndex="10"/>
                        <VBox fx:id="ticketTypesContainer" GridPane.rowIndex="10" GridPane.columnIndex="1" spacing="8">
                            <HBox spacing="8">
                                <Button text="Add Ticket Type" fx:id="addTicketTypeButton"/>
                            </HBox>
                            <VBox fx:id="ticketTypesEntriesBox" spacing="6">
                                <Label text="No ticket types added" fx:id="noTicketTypesLabel"/>
                            </VBox>
                        </VBox>

                        <!-- Distributor Assignment -->
                        <Label text="Assign Distributors:" GridPane.rowIndex="11"/>
                        <VBox GridPane.rowIndex="11" GridPane.columnIndex="1" spacing="4">
                            <Label text="Select which distributors can sell tickets for this event"
                                   style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                            <ListView fx:id="distributorsListView" prefHeight="120"/>
                        </VBox>

                        <!-- Submit -->
                        <Button text="Create Event"
                                fx:id="submitButton"
                                GridPane.rowIndex="12"
                                GridPane.columnIndex="1"/>
                    </GridPane>
                </ScrollPane>
            </Tab>

            <!-- MY EVENTS TAB -->
            <Tab text="My Events">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Your Events" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <Button text="Refresh" fx:id="refreshButton"/>
                        <Button text="Edit Selected" fx:id="editButton"/>
                        <Button text="Delete Selected" fx:id="deleteButton"/>
                        <Button text="Rate Distributor" fx:id="rateDistributorButton"/>
                    </HBox>
                    <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Event Name" prefWidth="150" fx:id="nameColumn"/>
                            <TableColumn text="Category" prefWidth="100" fx:id="categoryColumn"/>
                            <TableColumn text="Location" prefWidth="150" fx:id="locationColumn"/>
                            <TableColumn text="Event Date" prefWidth="150" fx:id="dateColumn"/>
                            <TableColumn text="Status" prefWidth="100" fx:id="statusColumn"/>
                            <TableColumn text="Capacity" prefWidth="80" fx:id="capacityColumn"/>
                            <TableColumn text="Updated At" prefWidth="150" fx:id="updatedAtColumn"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <Tab text="Notifications">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <Label text="Notifications" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <Button text="Refresh" fx:id="refreshNotificationsButton"/>
                        <Button text="Mark Selected Read" fx:id="markNotificationReadButton"/>
                        <Button text="Mark All Read" fx:id="markAllNotificationsReadButton"/>
                    </HBox>
                    <ListView fx:id="notificationsListView" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>

            <Tab text="Profile">
                <VBox spacing="14" style="-fx-padding: 20;">
                    <Label text="My Profile" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

                    <GridPane hgap="12" vgap="12">
                        <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="profileUsernameLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="profileEmailLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Organization Name:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="organizationNameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Commission (%):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="organizerCommissionLabel" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #6b7280;"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="saveProfileButton" text="Save Profile"/>
                        <Label fx:id="profileMessageLabel" text=""/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Reports">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Event Reports" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <TableView fx:id="reportsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Event Name" prefWidth="150" fx:id="reportNameColumn"/>
                            <TableColumn text="Category" prefWidth="100" fx:id="reportCategoryColumn"/>
                            <TableColumn text="Date" prefWidth="130" fx:id="reportDateColumn"/>
                            <TableColumn text="Status" prefWidth="80" fx:id="reportStatusColumn"/>
                            <TableColumn text="Location" prefWidth="130" fx:id="reportLocationColumn"/>
                            <TableColumn text="Tickets Sold" prefWidth="100" fx:id="reportTicketsSoldColumn"/>
                            <TableColumn text="Revenue" prefWidth="110" fx:id="reportRevenueColumn"/>
                        </columns>
                    </TableView>
                    <HBox spacing="24" style="-fx-padding: 8 12; -fx-background-color: #f3f4f6; -fx-border-color: #e5e5e5; -fx-border-radius: 6; -fx-background-radius: 6;" alignment="CENTER_LEFT">
                        <Label text="Total Tickets Sold:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="reportTotalTicketsLabel" text="0"/>
                        <Label text="Total Revenue:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="reportTotalRevenueLabel" text="€0.00"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

</BorderPane>