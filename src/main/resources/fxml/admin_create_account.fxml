<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.oktayosman.ticketcenter.controller.AdminCreateAccountController"
            stylesheets="@../styles.css">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12; -fx-border-color: #e5e5e5; -fx-border-width: 0 0 1 0;">
            <Label text="Create User Account" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" onAction="#handleBack" style="-fx-background-color: #6b7280; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="16" maxWidth="600">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>

            <!-- Basic Info -->
            <Label text="Account Information" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Separator/>

            <GridPane hgap="12" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="First Name *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="firstNameField" promptText="First name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Last Name *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="lastNameField" promptText="Last name" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Username *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="usernameField" promptText="Username" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Email *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" promptText="Email address" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Password *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" promptText="Password" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Confirm Password *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Role *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleComboBox" maxWidth="Infinity" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Organizer-specific fields -->
            <GridPane fx:id="organizerFieldsPane" hgap="12" vgap="12" visible="false" managed="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Organizer Details" GridPane.rowIndex="0" GridPane.columnSpan="2"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 0 4 0;"/>
                <Separator GridPane.rowIndex="1" GridPane.columnSpan="2"/>

                <Label text="Organization Name" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="organizationNameField" promptText="Company / organization name"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Commission (%)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="organizerCommissionField" promptText="e.g. 5.0"
                           GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Distributor-specific fields -->
            <GridPane fx:id="distributorFieldsPane" hgap="12" vgap="12" visible="false" managed="false">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70" hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Distributor Details" GridPane.rowIndex="0" GridPane.columnSpan="2"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 0 4 0;"/>
                <Separator GridPane.rowIndex="1" GridPane.columnSpan="2"/>

                <Label text="Commission Rate" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="commissionRateField" promptText="0.0–1.0  (e.g. 0.10 = 10%)"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Message & action buttons -->
            <Label fx:id="messageLabel" text="" wrapText="true" style="-fx-text-fill: #dc2626;"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Clear" onAction="#handleClear"/>
                <Button text="Create Account" onAction="#handleSave"
                        style="-fx-background-color: #059669; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>

